<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="980.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartcanteen.frontend.ManageMenuController">
    <!-- Top Header Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-background-color: #0f172a; -fx-padding: 14px 24px;">
            <children>
                <Button onAction="#handleBack" styleClass="button-secondary" style="-fx-text-fill: #e2e8f0; -fx-border-color: #475569;" text="← Back to Dashboard" />
                
                <VBox spacing="2.0">
                    <children>
                        <Label style="-fx-text-fill: #ffffff; -fx-font-size: 19px; -fx-font-weight: bold;" text="Manage Canteen Menu 📋" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" text="Add, update, or remove canteen food items and manage real-time availability" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </top>

    <!-- Center Content -->
    <center>
        <HBox spacing="24.0" style="-fx-background-color: #f8fafc;">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
            </padding>
            <children>
                <!-- Menu Items Table -->
                <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="title-label" style="-fx-font-size: 17px;" text="Current Menu Catalog" />
                        <TableView fx:id="menuTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="idColumn" prefWidth="60.0" text="ID" />
                                <TableColumn fx:id="nameColumn" prefWidth="180.0" text="Item Name" />
                                <TableColumn fx:id="categoryColumn" prefWidth="120.0" text="Category" />
                                <TableColumn fx:id="priceColumn" prefWidth="100.0" text="Price (₹)" />
                                <TableColumn fx:id="availableColumn" prefWidth="90.0" text="Availability" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <!-- Form Panel -->
                <VBox maxWidth="380.0" minWidth="330.0" spacing="14.0" styleClass="card-elevated">
                    <children>
                        <VBox spacing="2.0">
                            <children>
                                <Label styleClass="title-label" style="-fx-font-size: 18px;" text="Item Details" />
                                <Label styleClass="subtitle-label" text="Fill the form to add or select a row to edit" />
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="field-label" text="Item Name *" />
                                <TextField fx:id="nameField" promptText="e.g. Masala Dosa" />
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="field-label" text="Category *" />
                                <ComboBox fx:id="categoryComboBox" maxWidth="1.7976931348623157E308" promptText="Select Category" />
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="field-label" text="Price (₹) *" />
                                <TextField fx:id="priceField" promptText="e.g. 50.00" />
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="field-label" text="Description" />
                                <TextField fx:id="descriptionField" promptText="Brief item description" />
                            </children>
                        </VBox>

                        <CheckBox fx:id="availableCheckBox" selected="true" text="Available in Canteen" />

                        <!-- Form Action Buttons -->
                        <VBox spacing="10.0">
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                            <children>
                                <HBox spacing="10.0">
                                    <children>
                                        <Button maxWidth="1.7976931348623157E308" onAction="#handleAdd" styleClass="button-primary" text="➕ Add Item" HBox.hgrow="ALWAYS" />
                                        <Button maxWidth="1.7976931348623157E308" onAction="#handleUpdate" styleClass="button-primary" style="-fx-background-color: #0284c7;" text="✏ Update" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                                <HBox spacing="10.0">
                                    <children>
                                        <Button maxWidth="1.7976931348623157E308" onAction="#handleDelete" styleClass="button-danger" text="🗑 Delete" HBox.hgrow="ALWAYS" />
                                        <Button maxWidth="1.7976931348623157E308" onAction="#handleClearForm" styleClass="button-secondary" text="Clear Form" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                    </padding>
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>
