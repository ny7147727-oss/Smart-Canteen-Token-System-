<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="580.0" prefWidth="520.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartcanteen.frontend.LoginController">
    <children>
        <VBox alignment="CENTER" maxWidth="420.0" spacing="16.0" styleClass="card-elevated">
            <children>
                <VBox alignment="CENTER" spacing="4.0">
                    <children>
                        <Label styleClass="title-label" text="SmartServe 🍽" />
                        <Label styleClass="subtitle-label" text="Sign in to order fresh food and track live tokens" />
                    </children>
                </VBox>

                <VBox alignment="CENTER_LEFT" spacing="6.0">
                    <children>
                        <Label styleClass="field-label" text="Username" />
                        <TextField fx:id="usernameField" promptText="Enter your username" />
                    </children>
                    <VBox.margin>
                        <Insets top="8.0" />
                    </VBox.margin>
                </VBox>

                <VBox alignment="CENTER_LEFT" spacing="6.0">
                    <children>
                        <Label styleClass="field-label" text="Password" />
                        <PasswordField fx:id="passwordField" promptText="Enter your password" />
                    </children>
                </VBox>

                <Label fx:id="errorLabel" styleClass="error-label" text="" wrapText="true" />

                <Button maxWidth="1.7976931348623157E308" onAction="#handleLogin" styleClass="button-primary" text="Sign In →">
                    <VBox.margin>
                        <Insets top="4.0" />
                    </VBox.margin>
                </Button>

                <HBox alignment="CENTER" spacing="8.0">
                    <children>
                        <Label styleClass="subtitle-label" text="Don't have an account?" />
                        <Button onAction="#handleNavigateRegister" styleClass="button-secondary" text="Register Now" />
                    </children>
                    <VBox.margin>
                        <Insets top="8.0" />
                    </VBox.margin>
                </HBox>
            </children>
            <padding>
                <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
            </padding>
        </VBox>
    </children>
</StackPane>
