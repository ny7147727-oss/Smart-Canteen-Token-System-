<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="980.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartcanteen.frontend.LiveOrdersController">
    <!-- Top Header Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-background-color: #0f172a; -fx-padding: 14px 24px;">
            <children>
                <Button onAction="#handleBack" styleClass="button-secondary" style="-fx-text-fill: #e2e8f0; -fx-border-color: #475569;" text="← Back to Dashboard" />
                
                <VBox spacing="2.0">
                    <children>
                        <Label style="-fx-text-fill: #ffffff; -fx-font-size: 19px; -fx-font-weight: bold;" text="Kitchen Live Orders &amp; Queue ⚡" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" text="Real-time preparation dispatch for authorized/paid tokens" />
                    </children>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="12.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Button onAction="#handleRefresh" styleClass="button-secondary" style="-fx-text-fill: #e2e8f0; -fx-border-color: #475569;" text="🔄 Refresh Orders" />
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>

    <!-- Center Content -->
    <center>
        <VBox spacing="16.0" style="-fx-background-color: #f8fafc;">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
            </padding>
            <children>
                <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="tokenColumn" prefWidth="100.0" text="Token #" />
                        <TableColumn fx:id="userIdColumn" prefWidth="100.0" text="User ID" />
                        <TableColumn fx:id="totalColumn" prefWidth="130.0" text="Total (₹)" />
                        <TableColumn fx:id="statusColumn" prefWidth="160.0" text="Status" />
                        <TableColumn fx:id="timeColumn" prefWidth="200.0" text="Order Time" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- Action Panel -->
                <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="card-elevated">
                    <padding>
                        <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
                    </padding>
                    <children>
                        <Label styleClass="field-label" text="Order Status Actions:" />
                        <Button onAction="#handleMarkPreparing" styleClass="button-primary" style="-fx-background-color: #2563eb;" text="🍳 Mark Preparing" />
                        <Button onAction="#handleMarkReady" styleClass="button-primary" style="-fx-background-color: #16a34a;" text="🔔 Mark Ready" />
                        <Button onAction="#handleMarkCompleted" styleClass="button-primary" style="-fx-background-color: #475569;" text="✔ Mark Completed" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
